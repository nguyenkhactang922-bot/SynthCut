{
  "name": "tang-ai-video-editor",
  "version": "1.1.4",
  "description": "Tang AI Video Editor desktop UI on the SynthCut GPL base. Shows the timeline, clip library and preview; reflects AI edits live.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "author": "Tang AI Video Editor contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:renderer && electron .",
    "dev:renderer": "vite",
    "electron": "electron .",
    "prepare:bundle": "node --experimental-strip-types scripts/prepare-bundle.ts",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never",
    "dist:commercial": "electron-builder --win --config electron-builder.commercial.cjs --publish never"
  },
  "dependencies": {
    "@aive/core": "*",
    "@aive/mcp": "*",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.tang.aivideoeditor",
    "productName": "Tang AI Video Editor",
    "publish": [
      {
        "provider": "github",
        "owner": "nguyenkhactang922-bot",
        "repo": "SynthCut"
      }
    ],
    "copyright": "Copyright © 2026 Tang AI Video Editor contributors; SynthCut portions retain upstream notices",
    "electronVersion": "42.4.1",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "build/dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/resources/aive",
        "to": "aive"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "../../release/compliance/SOURCE_OFFER.md",
        "to": "SOURCE_OFFER.md"
      }
    ],
    "afterPack": "build/after-pack.cjs",
    "afterAllArtifactBuild": "build/afterbuild.cjs",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Tang-AI-Video-Editor-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tang AI Video Editor",
      "uninstallDisplayName": "Tang AI Video Editor",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
